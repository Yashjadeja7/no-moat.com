{
  // Must match the name of the Worker in the Cloudflare dashboard.
  "name": "no-moat",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }

  // View counter: create a KV namespace, then uncomment this and paste its ID.
  // ,"kv_namespaces": [{ "binding": "COUNTER", "id": "PASTE_NAMESPACE_ID_HERE" }]
}
