{
  // Must match the name of the Worker in the Cloudflare dashboard.
  "name": "no-moat",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // View counter storage (KV namespace "no-moat-counter").
  "kv_namespaces": [
    { "binding": "COUNTER", "id": "085a070413204bffb3f6a784449ced83" }
  ]
}
